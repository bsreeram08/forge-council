{
  "name": "forge-council",
  "version": "0.1.0",
  "description": "Multi-agent engineering council: 11 specialist personas iterate through Plan -> Build -> Review -> Fix until consensus quality is reached.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "forge": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "interactive": "bun run src/index.ts interactive",
    "setup": "bun run src/index.ts setup",
    "config:init": "bun run src/index.ts config init",
    "config:setup": "bun run src/index.ts config setup",
    "config:show": "bun run src/index.ts config show",
    "config:where": "bun run src/index.ts config where",
    "status": "bun run src/index.ts status",
    "sessions": "bun run src/index.ts sessions",
    "resume": "bun run src/index.ts resume",
    "logs": "bun run src/index.ts logs",
    "council": "bun run src/index.ts council",
    "test": "bun test",
    "link": "bun link",
    "unlink": "bun unlink",
    "typecheck": "bun run tsc --noEmit",
    "check": "bun run tsc --noEmit",
    "desktop": "electrobun dev",
    "desktop:build": "electrobun build"
  },
  "keywords": ["ai", "agents", "mastra", "council", "code-review", "multi-agent"],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@clack/prompts": "^1.1.0",
    "@mastra/core": "^1.10.0",
    "ai": "^6.0.116",
    "citty": "^0.2.1",
    "electrobun": "^1.15.1",
    "hono": "^4.12.5",
    "quansync": "^1.0.0",
    "zod": "^4.3.6"
  }
}
